{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/apply", "destination": "/index.html" },
    { "source": "/success", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/applications", "destination": "/admin/applications.html" },
    { "source": "/admin/applications/new", "destination": "/admin/applications.html" },
    { "source": "/admin/applications/:id", "destination": "/admin/application.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
